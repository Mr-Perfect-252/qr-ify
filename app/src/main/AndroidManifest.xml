<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- INTERNET / REQUEST_INSTALL_PACKAGES / RECEIVE_BOOT_COMPLETED are
         merged automatically from the ApexHub SDK manifest. -->

    <application
        android:name=".QrifyApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Qrify"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Used to share the generated QR image via ACTION_SEND.
             Uses a dedicated subclass + a distinct authority so it doesn't
             clash with the ApexHub SDK's own FileProvider. -->
        <provider
            android:name=".QrFileProvider"
            android:authorities="${applicationId}.qrprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
